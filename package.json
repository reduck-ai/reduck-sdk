{
  "name": "@reduck-ai/sdk",
  "version": "0.0.0",
  "description": "TypeScript SDK for the Reduck API: manage your browser scripts, devices and runs.",
  "license": "MIT",
  "author": "Reduck AI <contact@reduck.ai> (https://reduck.ai)",
  "homepage": "https://github.com/reduck-ai/reduck-sdk#readme",
  "bugs": "https://github.com/reduck-ai/reduck-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reduck-ai/reduck-sdk.git"
  },
  "keywords": [
    "reduck",
    "browser-automation",
    "sdk",
    "ai",
    "rpa"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "openapi.json",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.28.8",
  "scripts": {
    "generate": "openapi-ts",
    "update-spec": "node scripts/update-spec.mjs",
    "build": "rm -rf dist && pnpm generate && tsc -p tsconfig.build.json",
    "check": "pnpm generate && tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "smoke": "node test/smoke.mjs"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
